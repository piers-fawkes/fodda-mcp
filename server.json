{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.fodda/mcp-server",
  "title": "Fodda Knowledge Graphs",
  "description": "Expert-curated knowledge, brand, research & earnings intelligence — 46 tools, 220+ graphs.",
  "websiteUrl": "https://www.fodda.ai",
  "privacyPolicyUrl": "https://www.fodda.ai/privacy",
  "termsOfServiceUrl": "https://www.fodda.ai/terms",
  "supportContact": "support@fodda.ai",
  "icons": [
    {
      "src": "https://ucarecdn.com/6e7893d7-6b14-426b-83bc-574a3f72d6bc/foddafavicon.png",
      "sizes": [
        "any"
      ]
    }
  ],
  "version": "1.46.17",
  "repository": {
    "url": "https://github.com/piers-fawkes/fodda-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "transportType": "streamable-http",
      "url": "https://mcp.fodda.ai/mcp",
      "authorizationServerMetadataUrl": "https://mcp.fodda.ai/.well-known/oauth-authorization-server",
      "clientAuthentication": {
        "type": "oauth2"
      }
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "fodda-mcp",
      "version": "1.46.17",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "FODDA_API_KEY",
          "description": "Your Fodda API key",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "FODDA_API_URL",
          "description": "Upstream Fodda API URL",
          "isRequired": false,
          "default": "https://api.fodda.ai"
        }
      ]
    }
  ]
}
